ngBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TechnicalStatus_D_3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!sql_version.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>6pt</FontSize><FontWeight>Normal</FontWeight><Color>#172A3A</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>#D7E0E8</Color><Style>Solid</Style></Border><BackgroundColor>#FFFFFF</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TechnicalStatus_D_4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!result.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>6pt</FontSize><FontWeight>Normal</FontWeight><Color>#172A3A</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>#D7E0E8</Color><Style>Solid</Style></Border><BackgroundColor>#FFFFFF</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TechnicalStatus_D_5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!limitation.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>6pt</FontSize><FontWeight>Normal</FontWeight><Color>#172A3A</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>#D7E0E8</Color><Style>Solid</Style></Border><BackgroundColor>#FFFFFF</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></Cel