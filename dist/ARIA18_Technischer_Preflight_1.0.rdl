<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" MustUnderstand="df">
  <Description>Klinikneutraler ARIA-18-Collector fuer Durchsatz- und Klinikvergleiche.</Description>
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>/VarianTemplate/Data Sources/variandw</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6a650bc3-bb2e-44a4-a993-ffea62af1b18</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets><DataSet Name="TechnicalStatus"><Query><DataSourceName>DataSource1</DataSourceName><CommandText>SELECT N'1.0' AS preflight_version, N'18' AS tested_aria_major, N'NOT_DETECTED' AS installed_aria_version, CONVERT(nvarchar(255),SERVERPROPERTY('ProductVersion')) AS sql_version, CASE WHEN NOT (COL_LENGTH(N'DWH.DimPatient',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimPatient',N'IsMOTestPatient') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'IsMOTestPatient',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'DimMachineID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'DimMachineID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'MachineId') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'MachineId',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'TreatmentRecordDateTime') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'TreatmentRecordDateTime',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'IsImage') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'IsImage',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'IsBrachy') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'IsBrachy',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimActivityTransactionID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimActivityTransactionID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimActivityID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimActivityID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'AppointmentDateTime') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'AppointmentDateTime',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'AppointmentStatus') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'AppointmentStatus',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivity',N'DimActivityID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivity',N'OBJECT',N'SELECT',N'DimActivityID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivity',N'ActivityCode') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivity',N'OBJECT',N'SELECT',N'ActivityCode',N'COLUMN'),0)=1) OR (NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DeliveredMU') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DeliveredMU',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'FieldMUActual') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'FieldMUActual',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DoseDelivered') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DoseDelivered',N'COLUMN'),0)=1)) THEN N'CHECK_CAPABILITIES' ELSE N'SCHEMA_ACCESS_OK' END AS result, N'No clinical rows read; populated timestamps and clinical mappings not tested' AS limitation;</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="preflight_version"><DataField>preflight_version</DataField></Field><Field Name="tested_aria_major"><DataField>tested_aria_major</DataField></Field><Field Name="installed_aria_version"><DataField>installed_aria_version</DataField></Field><Field Name="sql_version"><DataField>sql_version</DataField></Field><Field Name="result"><DataField>result</DataField></Field><Field Name="limitation"><DataField>limitation</DataField></Field></Fields></DataSet><DataSet Name="Capabilities"><Query><DataSourceName>DataSource1</DataSourceName><CommandText>SELECT N'2.0' AS contract_version, source_name, column_name, is_required, CASE WHEN COL_LENGTH(source_name,column_name) IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(source_name,N'OBJECT',N'SELECT',column_name,N'COLUMN'),0)=1 THEN 1 ELSE 0 END AS available, CASE WHEN COL_LENGTH(source_name,column_name) IS NULL THEN 0 ELSE 1 END AS schema_available, COALESCE(HAS_PERMS_BY_NAME(source_name,N'OBJECT',N'SELECT',column_name,N'COLUMN'),0) AS select_allowed FROM (VALUES (N'DWH.DimPatient',N'DimPatientID',1),
(N'DWH.DimPatient',N'IsMOTestPatient',1),
(N'DWH.DimPatient',N'PatientId',0),
(N'DWH.DimPatient',N'PatientLastName',0),
(N'DWH.DimMachine',N'DimMachineID',1),
(N'DWH.DimMachine',N'MachineId',1),
(N'DWH.FactTreatmentHistory',N'DimPatientID',1),
(N'DWH.FactTreatmentHistory',N'DimCourseID',0),
(N'DWH.FactTreatmentHistory',N'DimPlanID',0),
(N'DWH.FactTreatmentHistory',N'DimFieldID',0),
(N'DWH.FactTreatmentHistory',N'DimActualMachineID',0),
(N'DWH.FactTreatmentHistory',N'DimPlanMachineID',0),
(N'DWH.FactTreatmentHistory',N'TreatmentRecordDateTime',1),
(N'DWH.FactTreatmentHistory',N'TreatmentStartTime',0),
(N'DWH.FactTreatmentHistory',N'TreatmentEndTime',0),
(N'DWH.FactTreatmentHistory',N'FractionNumber',0),
(N'DWH.FactTreatmentHistory',N'IsImage',1),
(N'DWH.FactTreatmentHistory',N'IsBrachy',1),
(N'DWH.FactTreatmentHistory',N'FractionsPlanned',0),
(N'DWH.FactTreatmentHistory',N'DeliveredMU',0),
(N'DWH.FactTreatmentHistory',N'FieldMUActual',0),
(N'DWH.FactTreatmentHistory',N'DoseDelivered',0),
(N'DWH.DimPlan',N'DimPlanID',0),
(N'DWH.DimPlan',N'NoFractionsPlanned',0),
(N'DWH.DimPlan',N'FirstDayOfTreatment',0),
(N'DWH.DimPlan',N'LastDayOfTreatment',0),
(N'DWH.DimActivityTransaction',N'DimActivityTransactionID',1),
(N'DWH.DimActivityTransaction',N'DimPatientID',1),
(N'DWH.DimActivityTransaction',N'DimActivityID',1),
(N'DWH.DimActivityTransaction',N'AppointmentDateTime',1),
(N'DWH.DimActivityTransaction',N'ctrActivitySer',0),
(N'DWH.DimActivityTransaction',N'ScheduledEndTime',0),
(N'DWH.DimActivityTransaction',N'ActivityStartDateTime',0),
(N'DWH.DimActivityTransaction',N'ActivityEndDateTime',0),
(N'DWH.DimActivityTransaction',N'AppointmentStatus',1),
(N'DWH.DimActivityTransaction',N'DerivedAppointmentTaskDate',0),
(N'DWH.DimActivityTransaction',N'AppointmentResourceStatus',0),
(N'DWH.DimActivityTransaction',N'IsScheduled',0),
(N'DWH.DimActivityTransaction',N'ctrResourceSer',0),
(N'DWH.DimActivityTransaction',N'DimResourceID',0),
(N'DWH.DimActivity',N'DimActivityID',1),
(N'DWH.DimActivity',N'ActivityCode',1),
(N'DWH.DimActivity',N'ctrActivitySer',0),
(N'DWH.DimActivity',N'ActivityRevCount',0),
(N'DWH.DimActivity',N'ActivityNameDEU',0),
(N'DWH.DimActivity',N'ActivityCategoryDEU',0),
(N'DWH.vv_ResourceInfo',N'ctrResourceSer',0),
(N'DWH.vv_ResourceInfo',N'ResourceId',0),
(N'DWH.InSightiveResourceMachine',N'DimResourceID',0),
(N'DWH.InSightiveResourceMachine',N'MachineId',0),
(N'DWH.DimActivityTransactionHistory',N'DimActivityTransactionID',0),
(N'DWH.DimActivityTransactionHistory',N'ScheduledActivityHstryDateTime',0),
(N'DWH.DimActivityTransactionHistory',N'ScheduledActivityCode',0),
(N'DWH.FactPatientImage',N'DimPatientID',0),
(N'DWH.FactPatientImage',N'DimMachineID',0),
(N'DWH.FactPatientImage',N'ImageCreationDate',0),
(N'DWH.FactPatientImage',N'DimCourseID',0),
(N'DWH.FactPatientImage',N'ctrImageSer',0),
(N'DWH.FactPatientImage',N'FactPatientImageID',0),
(N'DWH.FactPatientImage',N'ImageId',0),
(N'DWH.FactPatientImage',N'ImageType',0),
(N'DWH.FactPatientImage',N'ExposureTime',0)) v(source_name,column_name,is_required) UNION ALL SELECT N'2.0',N'DWH.FactTreatmentHistory',N'delivery_evidence_any_of_MU_or_dose',1,CASE WHEN NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DeliveredMU') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DeliveredMU',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'FieldMUActual') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'FieldMUActual',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DoseDelivered') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DoseDelivered',N'COLUMN'),0)=1) THEN 0 ELSE 1 END,CASE WHEN COL_LENGTH(N'DWH.FactTreatmentHistory',N'DeliveredMU') IS NULL AND COL_LENGTH(N'DWH.FactTreatmentHistory',N'FieldMUActual') IS NULL AND COL_LENGTH(N'DWH.FactTreatmentHistory',N'DoseDelivered') IS NULL THEN 0 ELSE 1 END,CASE WHEN COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DeliveredMU',N'COLUMN'),0)=1 OR COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'FieldMUActual',N'COLUMN'),0)=1 OR COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DoseDelivered',N'COLUMN'),0)=1 THEN 1 ELSE 0 END;</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="contract_version"><DataField>contract_version</DataField></Field><Field Name="source_name"><DataField>source_name</DataField></Field><Field Name="column_name"><DataField>column_name</DataField></Field><Field Name="is_required"><DataField>is_required</DataField></Field><Field Name="available"><DataField>available</DataField></Field><Field Name="schema_available"><DataField>schema_available</DataField></Field><Field Name="select_allowed"><DataField>select_allowed</DataField></Field></Fields></DataSet><DataSet Name="Scope"><Query><DataSourceName>DataSource1</DataSourceName><CommandText>SELECT N'DWH' AS source, N'SCHEMA_AND_PERMISSIONS_ONLY' AS check_scope UNION ALL SELECT N'VARIAN imaging / waiting area',N'NOT_TESTED_BY_THIS_REPORT' UNION ALL SELECT N'Activity mapping / timestamp completeness',N'REQUIRES_LOCAL_VALIDATION';</CommandText><Timeout>60</Timeout></Query><Fields><Field Name="source"><DataField>source</DataField></Field><Field Name="check_scope"><DataField>check_scope</DataField></Field></Fields></DataSet></DataSets><ReportSections>
    <ReportSection>
      <Body>
        <ReportItems><Tablix Name="Tablix_TechnicalStatus">
