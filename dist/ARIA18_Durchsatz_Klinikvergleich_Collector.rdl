        </Field>
        <Field Name="first_session">
          <DataField>first_session</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="last_session">
          <DataField>last_session</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="operating_span_minutes">
          <DataField>operating_span_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="avg_actual_minutes">
          <DataField>avg_actual_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="median_actual_minutes">
          <DataField>median_actual_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p25_actual_minutes">
          <DataField>p25_actual_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p75_actual_minutes">
          <DataField>p75_actual_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p90_actual_minutes">
          <DataField>p90_actual_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="avg_cycle_minutes">
          <DataField>avg_cycle_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="median_cycle_minutes">
          <DataField>median_cycle_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p25_cycle_minutes">
          <DataField>p25_cycle_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p75_cycle_minutes">
          <DataField>p75_cycle_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="p90_cycle_minutes">
          <DataField>p90_cycle_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="gap_count_lt15">
          <DataField>gap_count_lt15</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gap_count_15_29">
          <DataField>gap_count_15_29</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gap_count_30_59">
          <DataField>gap_count_30_59</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gap_count_60_119">
          <DataField>gap_count_60_119</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gap_count_ge120">
          <DataField>gap_count_ge120</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gap_minutes_ge30">
          <DataField>gap_minutes_ge30</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="max_gap_minutes">
          <DataField>max_gap_minutes</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="gross_device_hours">
          <DataField>gross_device_hours</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="net_proxy_hours">
          <DataField>net_proxy_hours</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="sessions_per_10_gross_hours">
          <DataField>sessions_per_10_gross_hours</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="sessions_per_10_net_proxy_hours">
          <DataField>sessions_per_10_net_proxy_hours</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="first_fraction_share_pct">
          <DataField>first_fraction_share_pct</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="adaptive_share_pct">
          <DataField>adaptive_share_pct</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
