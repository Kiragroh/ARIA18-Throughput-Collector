  <ReportParameters>
<ReportParameter Name="PeriodStart"><DataType>DateTime</DataType><DefaultValue><Values><Value>=DateSerial(2025, 1, 1)</Value></Values></DefaultValue><Prompt>Auswertung von</Prompt></ReportParameter>
<ReportParameter Name="PeriodEnd"><DataType>DateTime</DataType><DefaultValue><Values><Value>=DateSerial(2025, 12, 31)</Value></Values></DefaultValue><Prompt>Auswertung bis</Prompt></ReportParameter>
<ReportParameter Name="PeriodReason"><DataType>String</DataType><AllowBlank>true</AllowBlank><DefaultValue><Values><Value>=IIf(Parameters!PeriodStart.Value = DateSerial(2025,1,1) And Parameters!PeriodEnd.Value = DateSerial(2025,12,31), "Standardjahr 2025", "Abweichender Zeitraum")</Value></Values></DefaultValue><Hidden>true</Hidden></ReportParameter>
<ReportParameter Name="ContextStart"><DataType>DateTime</DataType><DefaultValue><Values><Value>=DateAdd("yyyy", -1, Parameters!PeriodStart.Value)</Value></Values></DefaultValue><Hidden>true</Hidden></ReportParameter>
