<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" MustUnderstand="df">
  <Description>Klinikneutraler ARIA-18-Collector fuer Durchsatz- und Klinikvergleiche.</Description>
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>/VarianTemplate/Data Sources/variandw</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6a650bc3-bb2e-44a4-a993-ffea62af1b18</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Metadata">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PeriodStart"><Value>=Parameters!PeriodStart.Value</Value></QueryParameter>
          <QueryParameter Name="@PeriodEnd"><Value>=Parameters!PeriodEnd.Value</Value></QueryParameter>
          <QueryParameter Name="@PeriodReason"><Value>=Parameters!PeriodReason.Value</Value></QueryParameter>
          <QueryParameter Name="@ContextStart"><Value>=Parameters!ContextStart.Value</Value></QueryParameter>
          <QueryParameter Name="@DataThrough"><Value>=Parameters!DataThrough.Value</Value></QueryParameter>
          <QueryParameter Name="@DataThroughConfirmed"><Value>=Parameters!DataThroughConfirmed.Value</Value></QueryParameter>
          <QueryParameter Name="@SiteLabel"><Value>=Parameters!SiteLabel.Value</Value></QueryParameter>
          <QueryParameter Name="@IncludePseudonymizedDetails"><Value>=Parameters!IncludePseudonymizedDetails.Value</Value></QueryParameter>
          <QueryParameter Name="@RunId"><Value>=Parameters!RunId.Value</Value></QueryParameter>
        </QueryParameters>
        <CommandText>SELECT N'2.0' AS contract_version,@RunId AS run_id,@SiteLabel AS site,@PeriodStart AS period_start,@PeriodEnd AS period_end,@PeriodReason AS period_reason,@ContextStart AS context_start,@DataThrough AS data_through,@DataThroughConfirmed AS data_through_confirmed,@IncludePseudonymizedDetails AS details_included,N'2.0.0-rc.9' AS collector_release,N'18' AS tested_aria_major,N'NOT_DETECTED_FROM_DWH' AS aria_version_status,1 AS comparison_population_complete,CASE WHEN NOT (COL_LENGTH(N'DWH.FactPatientImage',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactPatientImage',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactPatientImage',N'DimMachineID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactPatientImage',N'OBJECT',N'SELECT',N'DimMachineID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactPatientImage',N'ImageCreationDate') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactPatientImage',N'OBJECT',N'SELECT',N'ImageCreationDate',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimPatient',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimPatient',N'IsMOTestPatient') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'IsMOTestPatient',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'DimMachineID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'DimMachineID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'MachineId') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'MachineId',N'COLUMN'),0)=1) THEN N'UNAVAILABLE' ELSE N'AVAILABLE' END AS image_objects_state,CASE WHEN NOT (COL_LENGTH(N'DWH.DimPatient',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimPatient',N'IsMOTestPatient') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimPatient',N'OBJECT',N'SELECT',N'IsMOTestPatient',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'DimMachineID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'DimMachineID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimMachine',N'MachineId') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimMachine',N'OBJECT',N'SELECT',N'MachineId',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'TreatmentRecordDateTime') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'TreatmentRecordDateTime',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'IsImage') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'IsImage',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'IsBrachy') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'IsBrachy',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimActivityTransactionID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimActivityTransactionID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimPatientID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimPatientID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'DimActivityID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'DimActivityID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'AppointmentDateTime') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'AppointmentDateTime',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivityTransaction',N'AppointmentStatus') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivityTransaction',N'OBJECT',N'SELECT',N'AppointmentStatus',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivity',N'DimActivityID') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivity',N'OBJECT',N'SELECT',N'DimActivityID',N'COLUMN'),0)=1) OR NOT (COL_LENGTH(N'DWH.DimActivity',N'ActivityCode') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.DimActivity',N'OBJECT',N'SELECT',N'ActivityCode',N'COLUMN'),0)=1) OR (NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DeliveredMU') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DeliveredMU',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'FieldMUActual') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'FieldMUActual',N'COLUMN'),0)=1) AND NOT (COL_LENGTH(N'DWH.FactTreatmentHistory',N'DoseDelivered') IS NOT NULL AND COALESCE(HAS_PERMS_BY_NAME(N'DWH.FactTreatmentHistory',N'OBJECT',N'SELECT',N'DoseDelivered',N'COLUMN'),0)=1)) THEN N'EVENTS_UNAVAILABLE_CHECK_CAPABILITIES' ELSE N'READY' END AS collection_state;</CommandText>
        <Timeout>600</Timeout><rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="contract_version">
          <DataField>contract_version</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="run_id">
          <DataField>run_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
